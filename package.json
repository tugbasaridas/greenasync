{
  "name": "greenasync",
  "private": true,
  "version": "0.5.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run start:dev --workspace backend",
    "dev:backend:local": "node scripts/dev-backend-local.mjs",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "setup:speech": "node scripts/setup-speech.mjs",
    "measure": "node scripts/measure.mjs",
    "measure:demo": "node scripts/measure-demo.mjs",
    "measure:serve": "node scripts/measure-server.mjs",
    "measure:audit": "node scripts/run-lighthouse.mjs"
  }
}

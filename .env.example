# Copy this file to .env in the repository root.
# For Docker: change the same password here and in DATABASE_URL.
POSTGRES_USER=greenasync
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=greenasync
#DATABASE_URL=postgresql://postgres:1234@127.0.0.1:5432/greenasync
# Optional: absolute permanent audio directory. Default: <repo>/uploads/audio
# UPLOAD_DIR=C:/greenasync-data/audio
PORT=3000

# Optional local-demo settings. Without DATABASE_URL, disk-backed embedded PostgreSQL is used.
HR_USERNAME=ik
# HR_PASSWORD=choose-your-own-password-at-least-8-characters
WHISPER_MODEL=tiny
# WHISPER_PYTHON=C:/path/to/python.exe
# DATA_DIR=C:/greenasync-data/database
